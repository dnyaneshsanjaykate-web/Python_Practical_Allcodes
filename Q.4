//RIGHT ANGLED TRIANGLE STAR PATTERN
n = int(input("Enter number of rows: "))

for i in range(1, n + 1):
    for j in range(i):
        print("*", end=" ")
    print()



//NUMBER PYRAMID
    n = int(input("Enter number of rows: "))

i = 1
while i <= n:
    j = 1
    while j <= i:
        print(j, end=" ")
        j += 1
    print()
    i += 1




//PASCAL TRIANGLE

n = int(input("Enter number of rows: "))

for i in range(n):
    num = 1

    for j in range(n - i - 1):
        print(" ", end="")

    for j in range(i + 1):
        print(num, end=" ")
        num = num * (i - j) // (j + 1)

    print()
