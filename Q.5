for n in range(1, 51):

    # Skip multiples of 3
    if n % 3 == 0:
        continue

    # Stop if number greater than 40 is prime
    if n > 40 and all(n % i != 0 for i in range(2, n)):
        print("Prime number found:", n)
        break

    # Placeholder for future feature
    if n == 10:
        pass

    print(n)

else:
    print("Loop completed without interruption")
