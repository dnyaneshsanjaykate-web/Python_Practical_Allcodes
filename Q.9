# Create a list of 5 students
students = ["Asha", "Ravi", "Meera", "Kiran", "Neha"]

# Display students present
print("Students Present:", students)

# Add a new student
students.append("Rahul")
print("After adding a student:", students)

# Remove an absent student
students.remove("Ravi")
print("After removing an absent student:", students)

# Display total students present
print("Total Students Present:", len(students))

# Display final attendance list
print("Final Attendance List:", students)
