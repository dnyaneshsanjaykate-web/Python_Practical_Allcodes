students = [
    ("Asha", 78, 85, 92),
    ("Ravi", 65, 70, 58),
    ("Meera", 88, 91, 79),
    ("Kiran", 45, 52, 61)
]

# a) Total and average of each student
totals = [(s[0], sum(s[1:]), round(sum(s[1:]) / len(s[1:]), 2))
          for s in students]

print("Total and Average:")
for name, total, avg in totals:
    print(name, "Total:", total, "Average:", avg)

# b) Topper and lowest scorer
topper = max(students, key=lambda s: sum(s[1:]))
lowest = min(students, key=lambda s: sum(s[1:]))

print("\nTopper:", topper[0], "Total:", sum(topper[1:]))
print("Lowest Scorer:", lowest[0], "Total:", sum(lowest[1:]))

# c) Rank students by total marks
ranked = sorted(students, key=lambda s: sum(s[1:]), reverse=True)

print("\nStudent Rankings:")
for rank, s in enumerate(ranked, 1):
    print(rank, s[0], "Total:", sum(s[1:]))

# d) Create dictionary using zip() and dict()
names = [s[0] for s in students]
total_marks = [sum(s[1:]) for s in students]

result = dict(zip(names, total_marks))
print("\nStudent Total Dictionary:", result)

# e) Use any() and all()
below_50 = any(mark < 50 for s in students for mark in s[1:])
above_60 = all(sum(s[1:]) / len(s[1:]) > 60 for s in students)

print("\nAny student scored below 50:", below_50)
print("All students average above 60:", above_60)
